---
import Base from "../../layouts/Base.astro";
import { getUi, langPaths, localePath, API_URL, GAME_URL, type Lang } from "../../i18n";
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;
const ui = getUi(lang);
const a = ui.account;
const cls = ui.ranking.classNames;
---
<Base lang={lang} page="compte" title={a.title} description={a.intro}>
  <div class="wrap page-head"><h1>{a.title}</h1><p>{a.intro}</p></div>

  <section class="page-section">
    <div class="wrap">
      <div id="auth-panel">
      <div class="social" id="social" hidden>
        <button type="button" class="btn-google" id="google-btn">
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.9 2.4 30.4 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/><path fill="#FBBC05" d="M10.5 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.9 2.3-8.4 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
          <span>{a.google}</span>
        </button>
        <p class="social-or"><span>{a.or}</span></p>
        <p class="account-error" id="google-error" role="alert" hidden></p>
      </div>
      <div class="auth-tabs" role="tablist">
        <button type="button" role="tab" id="tab-login" class="active" aria-selected="true">{a.tabLogin}</button>
        <button type="button" role="tab" id="tab-signup" aria-selected="false">{a.tabSignup}</button>
      </div>
      <form id="login-form" class="account-card" autocomplete="on">
        <label for="acc-email">{a.email}</label>
        <input id="acc-email" name="email" type="email" required autocomplete="username" />
        <label for="acc-pass">{a.password}</label>
        <input id="acc-pass" name="password" type="password" required minlength="8" autocomplete="current-password" />
        <p class="account-error" id="login-error" role="alert" hidden></p>
        <button class="btn btn-primary" type="submit" id="login-btn">{a.login}</button>
        <p class="account-note">{a.privacy}</p>
      </form>

      <form id="signup-form" class="account-card" autocomplete="on" hidden>
        <label for="su-email">{a.email}</label>
        <input id="su-email" name="email" type="email" required maxlength="120" autocomplete="username" />
        <label for="su-pass">{a.password} <small>({a.passwordHint})</small></label>
        <input id="su-pass" name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password" />
        <label for="su-pass2">{a.passwordConfirm}</label>
        <input id="su-pass2" name="password2" type="password" required minlength="8" maxlength="72" autocomplete="new-password" />
        <div class="hp-field" aria-hidden="true"><label for="su-site">Website</label><input id="su-site" name="siteweb" type="text" tabindex="-1" autocomplete="off" /></div>
        <label class="consent"><input id="su-consent" type="checkbox" required /> <span>{a.consent} (<a href={localePath(lang, "confidentialite")}>{a.privacyLink}</a>)</span></label>
        <p class="account-error" id="signup-error" role="alert" hidden></p>
        <button class="btn btn-primary" type="submit" id="signup-btn">{a.signup}</button>
        <p class="account-note">{a.privacy}</p>
      </form>
      </div>

      <div id="profile" hidden>
        <div class="profile-head">
          <h2>{a.characters}</h2>
          <button class="btn btn-secondary" type="button" id="logout-btn">{a.logout}</button>
        </div>
        <p class="account-welcome" id="welcome" hidden>{a.welcome}</p>
        <p class="account-error" id="profile-error" role="alert" hidden></p>
        <div class="char-grid" id="char-grid"></div>
        <p class="rank-status" id="char-empty" hidden>{a.none}</p>
        <p class="center mt"><button class="btn btn-primary" type="button" id="open-game">🎮 {a.openGame}</button></p>
      </div>

      <div class="prose mt center"><h2>{a.noAccountTitle}</h2><p>{a.noAccountText}</p></div>
    </div>
  </section>

  <script define:vars={{ api: API_URL, gameUrl: GAME_URL, msg: { errorLogin: a.errorLogin, errorLocked: a.errorLocked, errorNetwork: a.errorNetwork, expired: a.expired, errorGoogle: a.errorGoogle, errorGoogleExists: a.errorGoogleExists, mismatch: a.mismatch, errorExists: a.errorExists, errorInvalid: a.errorInvalid, errorRateSignup: a.errorRateSignup, signup: a.signup, signingUp: a.signingUp, level: a.level, xp: a.xp, gold: a.gold, gems: a.gems, achievements: a.achievements, rank: a.rank, noTitle: a.noTitle, logging: a.logging, login: a.login }, classNames: cls }}>
    const KEY = "pixelfe_site_session";
    const $ = (id) => document.getElementById(id);
    const loginForm = $("login-form"), signupForm = $("signup-form"), authPanel = $("auth-panel"), profile = $("profile"), grid = $("char-grid");
    const store = { get: () => { try { return sessionStorage.getItem(KEY); } catch { return null; } }, set: (v) => { try { sessionStorage.setItem(KEY, v); } catch {} }, del: () => { try { sessionStorage.removeItem(KEY); } catch {} } };
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const show = (node, msg) => { node.textContent = msg; node.hidden = !msg; };

    function stat(label, value) { const d = el("div", "char-stat"); d.append(el("span", "", label), el("strong", "", value)); return d; }
    function renderProfile(data) {
      grid.replaceChildren();
      $("char-empty").hidden = data.personnages.length > 0;
      for (const p of data.personnages) {
        const card = el("div", "char-card");
        const img = el("img"); img.src = "/assets/img/hero-" + p.classe + ".png"; img.alt = ""; img.loading = "lazy";
        card.append(img, el("h3", "", p.pseudo), el("div", "char-title", (classNames[p.classe] || p.classe) + " · " + (p.titre || msg.noTitle)));
        const bar = el("div", "xp-bar"); const fill = el("span"); fill.style.width = Math.min(100, Math.round(100 * p.xp / Math.max(1, p.xpRequis))) + "%"; bar.append(fill);
        card.append(bar);
        const stats = el("div", "char-stats");
        stats.append(
          stat(msg.level, String(p.niveau)),
          stat(msg.xp, p.xp + " / " + p.xpRequis),
          stat(msg.gold, p.or.toLocaleString()),
          stat(msg.gems, p.gemmes.toLocaleString()),
          stat(msg.achievements, p.hautsFaits + " / " + data.hautsFaitsTotal),
          stat(msg.rank, p.rang ? "#" + p.rang : "—"),
        );
        card.append(stats);
        grid.append(card);
      }
      authPanel.hidden = true; profile.hidden = false;
    }
    function logoutLocal(message) { store.del(); profile.hidden = true; authPanel.hidden = false; $("welcome").hidden = true; setTab("login"); show($("login-error"), message || ""); }

    async function loadProfile(token) {
      try {
        const res = await fetch(api + "/api/site/profil", { headers: { Authorization: "Bearer " + token } });
        if (res.status === 401) return logoutLocal(msg.expired);
        if (!res.ok) throw new Error();
        renderProfile(await res.json());
      } catch { authPanel.hidden = true; profile.hidden = false; show($("profile-error"), msg.errorNetwork); }
    }

    function setTab(which) {
      const login = which === "login";
      loginForm.hidden = !login; signupForm.hidden = login;
      $("tab-login").classList.toggle("active", login); $("tab-signup").classList.toggle("active", !login);
      $("tab-login").setAttribute("aria-selected", String(login)); $("tab-signup").setAttribute("aria-selected", String(!login));
    }
    $("tab-login").addEventListener("click", () => setTab("login"));
    $("tab-signup").addEventListener("click", () => setTab("signup"));

    signupForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      show($("signup-error"), "");
      if ($("su-pass").value !== $("su-pass2").value) return show($("signup-error"), msg.mismatch);
      const btn = $("signup-btn"); btn.disabled = true; btn.textContent = msg.signingUp;
      try {
        const res = await fetch(api + "/api/site/inscription", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: $("su-email").value, motDePasse: $("su-pass").value, siteweb: $("su-site").value }) });
        if (res.status === 409) show($("signup-error"), msg.errorExists);
        else if (res.status === 429) show($("signup-error"), msg.errorRateSignup);
        else if (!res.ok) show($("signup-error"), msg.errorInvalid);
        else { const { token } = await res.json(); $("su-pass").value = ""; $("su-pass2").value = ""; store.set(token); await loadProfile(token); $("welcome").hidden = false; }
      } catch { show($("signup-error"), msg.errorNetwork); }
      btn.disabled = false; btn.textContent = msg.signup;
    });

    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = $("login-btn"); btn.disabled = true; btn.textContent = msg.logging; show($("login-error"), "");
      try {
        const res = await fetch(api + "/api/site/connexion", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: $("acc-email").value, motDePasse: $("acc-pass").value }) });
        if (res.status === 429) show($("login-error"), msg.errorLocked);
        else if (!res.ok) show($("login-error"), msg.errorLogin);
        else { const { token } = await res.json(); $("acc-pass").value = ""; store.set(token); await loadProfile(token); }
      } catch { show($("login-error"), msg.errorNetwork); }
      btn.disabled = false; btn.textContent = msg.login;
    });
    $("logout-btn").addEventListener("click", async () => {
      const token = store.get();
      logoutLocal("");
      if (token) fetch(api + "/api/site/deconnexion", { method: "POST", headers: { Authorization: "Bearer " + token } }).catch(() => {});
    });
    $("open-game").addEventListener("click", async () => {
      const token = store.get(); if (!token) return;
      const win = window.open("about:blank", "_blank");
      try {
        const res = await fetch(api + "/api/site/ticket", { method: "POST", headers: { Authorization: "Bearer " + token } });
        if (res.status === 401) { if (win) win.close(); return logoutLocal(msg.expired); }
        const { ticket } = await res.json();
        const url = gameUrl + "/#ticket=" + ticket;
        if (win) win.location.href = url; else location.href = url;
      } catch { if (win) win.close(); show($("profile-error"), msg.errorNetwork); }
    });

    // Connexion Google : le fournisseur n'apparaît que si le serveur l'a configuré.
    // Le script de Google n'est chargé qu'ici, sur la page Compte.
    let googleClient = null;
    async function afterAuth(token) { store.set(token); await loadProfile(token); }
    fetch(api + "/api/site/fournisseurs").then((r) => r.json()).then(({ google }) => {
      if (!google) return;
      const s = document.createElement("script");
      s.src = "https://accounts.google.com/gsi/client"; s.async = true;
      s.onload = () => {
        googleClient = google_client_init(google);
        $("social").hidden = false;
      };
      document.head.append(s);
    }).catch(() => {});
    function google_client_init(clientId) {
      return window.google.accounts.oauth2.initTokenClient({
        client_id: clientId,
        scope: "openid email",
        callback: async (resp) => {
          if (!resp || !resp.access_token) return show($("google-error"), msg.errorGoogle);
          try {
            const res = await fetch(api + "/api/site/google", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ accessToken: resp.access_token }) });
            if (res.status === 409) return show($("google-error"), msg.errorGoogleExists);
            if (!res.ok) return show($("google-error"), msg.errorGoogle);
            const { token } = await res.json();
            await afterAuth(token);
          } catch { show($("google-error"), msg.errorNetwork); }
        },
        error_callback: () => show($("google-error"), msg.errorGoogle),
      });
    }
    $("google-btn").addEventListener("click", () => { show($("google-error"), ""); if (googleClient) googleClient.requestAccessToken(); });

    const existing = store.get(); if (existing) loadProfile(existing);
  </script>
</Base>
