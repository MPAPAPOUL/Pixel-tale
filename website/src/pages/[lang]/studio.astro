---
import Base from "../../layouts/Base.astro";
import { getUi, langPaths, KOFI_URL, type Lang } from "../../i18n";
export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;
const ui = getUi(lang);
const s = ui.studio;
---
<Base lang={lang} page="studio" title={s.title} description={s.intro}>
  <div class="wrap page-head"><img class="hero-logo" src="/assets/img/logo-pixelfe.webp" alt="Pixelfe" /><h1>{s.title}</h1><p>{s.intro}</p></div>
  <section class="page-section">
    <div class="wrap">
      <div class="prose center"><h2>{s.missionTitle}</h2><p>{s.mission}</p></div>
      <div class="section-head mt"><h2>{s.valuesTitle}</h2></div>
      <div class="features-grid" style="grid-template-columns:repeat(3,1fr)">
        {s.values.map((v) => <div class="feature"><span class="icon">{v.icon}</span><h4>{v.title}</h4><p>{v.text}</p></div>)}
      </div>
      <div class="prose center mt"><h2>{s.universeTitle}</h2><p>{s.universeText}</p></div>
      <div class="prose center"><h2>{s.contactTitle}</h2><p>{s.contactText}</p>
        <a class="btn btn-secondary" href={KOFI_URL} target="_blank" rel="noopener">☕ {s.contactCta}</a></div>
    </div>
  </section>
</Base>
